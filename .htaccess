RewriteEngine On
RewriteBase /giftvibe-new-/

# Redirect direct access to .php files to clean URLs
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Explicitly rewrite root requests to the front controller
RewriteRule ^$ public/index.php?route= [QSA,L]

# Serve public assets through the clean project URL
RewriteRule ^assets/(.*)$ public/assets/$1 [L]
RewriteRule ^admin/assets/(.*)$ admin/assets/$1 [L]

# Admin portal front controller
RewriteRule ^admin/?$ admin/index.php?route=/ [QSA,L]
RewriteRule ^admin/(.*)$ admin/index.php?route=$1 [QSA,L]

# Front controller pattern
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php?route=$1 [QSA,L]
