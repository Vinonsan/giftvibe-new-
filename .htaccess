Options -Indexes
DirectoryIndex public/index.php

<FilesMatch "^(config\.php|schema\.sql|DEPLOYMENT\.md)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/index.php [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.+)$ public/$1 [L,QSA]
</IfModule>
