Options -Indexes
DirectoryIndex public/index.php

<FilesMatch "^(\.env(?:\..*)?|config\.php|config\.local\.php|schema\.sql|DEPLOYMENT\.md)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^(.+)$ public/$1 [L,QSA]
</IfModule>
